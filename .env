# Database configuration
# To use MySQL/PostgreSQL, uncomment and configure:
# DATABASE_URL=postgresql://username:password@localhost:5432/crm
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/crm
DATABASE_URL=sqlite:///./crm.db

# Groq API Configuration
# Replace with your actual Groq API key to use LLM models
GROQ_API_KEY=

# Server setup
HOST=127.0.0.1
PORT=8000
